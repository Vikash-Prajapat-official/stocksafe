# Copy to .env and edit: cp .env.example .env
# Inside Docker Compose the database host is "db". For local dev outside Docker use localhost:5434 (set DB_PORT to change).
DATABASE_URL=postgresql://stocksafe:change-me@db:5432/stocksafe
POSTGRES_PASSWORD=change-me
# Optional: leave blank and the app makes a random one on first start and keeps it. Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
APP_URL=http://localhost:3002
PORT=3002
EXPIRY_ALERT_DAYS=90,60,30
# Optional email digest (sent every morning at 06:30 India time)
# SMTP_URL examples: smtp://user:password@mail.example.org:587   or   smtps://user:password@smtp.example.org:465
SMTP_URL=
SMTP_FROM="StockSafe <stocksafe@your-hospital.example>"
DIGEST_TO=
# Patient names on dispensing are anonymised after this many days
RETENTION_DAYS=90
# Encrypts nightly backups. At least 12 characters. KEEP A COPY somewhere safe: without it a backup cannot be opened.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
BACKUP_PASSPHRASE=
# How many days of nightly backups to keep, and the hour (0-23, India time) they run
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=2
# Password for the demo accounts created by the seed (phones 9000000001 to 9000000005)
SEED_PASSWORD=ChangeMe@123
# Set to 0 for a real hospital: the seed then adds no demo history (six months of synthetic movements) and you start empty
# SEED_DEMO=0

# --- Public demo hosting (Vercel + Neon): see docs/DEPLOY_DEMO.md. Never set these on a real hospital install ---
# DEMO_MODE=1        shows a banner and stops anyone changing users or passwords
# CRON_SECRET=       at least 16 random characters; lets Vercel Cron run the nightly jobs (/api/cron/nightly)

# --- Single-PC mode (no Docker, no PostgreSQL) ---
# Use this instead of the PostgreSQL DATABASE_URL above. The file is created in the prisma/ folder.
# DATABASE_URL=file:./stocksafe.db
# Where encrypted backups go in single-PC mode (default: ./backups). Needs BACKUP_PASSPHRASE above.
# BACKUP_DIR=./backups

// StockSafe data model (SPEC.md section 4).
// Money is integer paise. Quantity is an integer in the item's smallest unit. No floats.
// StockBalance changes only inside src/lib/stock.ts, in the same transaction that inserts a StockMovement.
// StockMovement is append-only: a database trigger (see migrations) rejects UPDATE and DELETE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STOREKEEPER
  PHARMACIST
  NURSE
  ADMIN
  AUDITOR
}

enum StoreType {
  MAIN
  PHARMACY
  WARD
}

enum ItemForm {
  TABLET
  CAPSULE
  INJECTION
  SYRUP
  OINTMENT
  DROPS
  CONSUMABLE
  OTHER
}

enum Storage {
  ROOM
  COLD // 2 to 8 C
}

enum MovementType {
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  DISPENSE
  RETURN_IN
  RETURN_TO_SUPPLIER
  ADJUSTMENT
  EXPIRY_WRITEOFF
}

enum IndentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIAL
  ISSUED
  REJECTED
}

enum StockCountStatus {
  OPEN
  SUBMITTED
  APPROVED
}

model Hospital {
  id            String  @id @default(cuid())
  name          String
  gstin         String?
  drugLicenceNo String? @map("drug_licence_no")
  settings      Json    @default("{}")

  @@map("hospital")
}

model User {
  id           String  @id @default(cuid())
  name         String
  phone        String  @unique
  passwordHash String  @map("password_hash")
  role         Role
  active       Boolean @default(true)

  stores         UserStore[]
  movements      StockMovement[] @relation("MovementActor")
  approvedMoves  StockMovement[] @relation("MovementApprover")
  grns           Grn[]
  indentsCreated Indent[]
  countsStarted  StockCount[]    @relation("CountStarter")
  countsApproved StockCount[]    @relation("CountApprover")
  auditLogs      AuditLog[]

  @@map("user")
}

model Store {
  id     String    @id @default(cuid())
  name   String    @unique
  type   StoreType
  active Boolean   @default(true)

  users       UserStore[]
  balances    StockBalance[]
  movements   StockMovement[]
  indentsFrom Indent[]        @relation("IndentFrom")
  indentsTo   Indent[]        @relation("IndentTo")
  counts      StockCount[]

  @@map("store")
}

model UserStore {
  userId  String @map("user_id")
  storeId String @map("store_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@map("user_store")
}

model Item {
  id           String   @id @default(cuid())
  name         String
  genericName  String?  @map("generic_name")
  strength     String?
  form         ItemForm
  unit         String // smallest unit, e.g. "tablet", "ml", "vial"
  category     String?
  isEssential  Boolean  @default(false) @map("is_essential") // NLEM
  storage      Storage  @default(ROOM)
  minLevel     Int      @default(0) @map("min_level")
  reorderLevel Int      @default(0) @map("reorder_level")
  maxLevel     Int      @default(0) @map("max_level")
  active       Boolean  @default(true)

  batches     Batch[]
  indentLines IndentLine[]

  @@index([name])
  @@map("item")
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  gstin   String?
  address String?

  batches Batch[]
  grns    Grn[]

  @@map("supplier")
}

model Batch {
  id         String   @id @default(cuid())
  itemId     String   @map("item_id")
  batchNo    String   @map("batch_no")
  expiryDate DateTime @map("expiry_date") @db.Date
  mrpPaise   Int      @map("mrp_paise")
  costPaise  Int      @map("cost_paise")
  supplierId String?  @map("supplier_id")

  item       Item             @relation(fields: [itemId], references: [id])
  supplier   Supplier?        @relation(fields: [supplierId], references: [id])
  balances   StockBalance[]
  movements  StockMovement[]
  countLines StockCountLine[]

  @@unique([itemId, batchNo])
  @@index([expiryDate])
  @@map("batch")
}

// quantity >= 0 is enforced by a CHECK constraint in the migration.
model StockBalance {
  storeId  String @map("store_id")
  batchId  String @map("batch_id")
  quantity Int

  store Store @relation(fields: [storeId], references: [id])
  batch Batch @relation(fields: [batchId], references: [id])

  @@id([storeId, batchId])
  @@map("stock_balance")
}

// Append-only ledger. quantity is signed: positive in, negative out.
model StockMovement {
  id           String       @id @default(cuid())
  type         MovementType
  batchId      String       @map("batch_id")
  storeId      String       @map("store_id")
  quantity     Int
  refType      String?      @map("ref_type")
  refId        String?      @map("ref_id")
  reason       String?
  patientLabel String?      @map("patient_label")
  actorUserId  String       @map("actor_user_id")
  approvedBy   String?      @map("approved_by")
  at           DateTime     @default(now())

  batch    Batch @relation(fields: [batchId], references: [id])
  store    Store @relation(fields: [storeId], references: [id])
  actor    User  @relation("MovementActor", fields: [actorUserId], references: [id])
  approver User? @relation("MovementApprover", fields: [approvedBy], references: [id])

  @@index([batchId, storeId, at])
  @@index([storeId, at])
  @@index([type, at])
  @@map("stock_movement")
}

model Grn {
  id          String   @id @default(cuid())
  supplierId  String   @map("supplier_id")
  invoiceNo   String   @map("invoice_no")
  invoiceDate DateTime @map("invoice_date") @db.Date
  receivedBy  String   @map("received_by")
  receivedAt  DateTime @default(now()) @map("received_at")
  totalPaise  Int      @map("total_paise")

  supplier Supplier @relation(fields: [supplierId], references: [id])
  receiver User     @relation(fields: [receivedBy], references: [id])

  @@map("grn")
}

model Indent {
  id          String       @id @default(cuid())
  fromStoreId String       @map("from_store_id") // requesting ward
  toStoreId   String       @map("to_store_id") // supplying store
  status      IndentStatus @default(DRAFT)
  createdBy   String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")

  fromStore Store        @relation("IndentFrom", fields: [fromStoreId], references: [id])
  toStore   Store        @relation("IndentTo", fields: [toStoreId], references: [id])
  creator   User         @relation(fields: [createdBy], references: [id])
  lines     IndentLine[]

  @@map("indent")
}

model IndentLine {
  id           String @id @default(cuid())
  indentId     String @map("indent_id")
  itemId       String @map("item_id")
  qtyRequested Int    @map("qty_requested")
  qtyIssued    Int    @default(0) @map("qty_issued")

  indent Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id])

  @@map("indent_line")
}

model StockCount {
  id         String           @id @default(cuid())
  storeId    String           @map("store_id")
  status     StockCountStatus @default(OPEN)
  startedBy  String           @map("started_by")
  approvedBy String?          @map("approved_by")

  store    Store            @relation(fields: [storeId], references: [id])
  starter  User             @relation("CountStarter", fields: [startedBy], references: [id])
  approver User?            @relation("CountApprover", fields: [approvedBy], references: [id])
  lines    StockCountLine[]

  @@map("stock_count")
}

model StockCountLine {
  id         String @id @default(cuid())
  countId    String @map("count_id")
  batchId    String @map("batch_id")
  systemQty  Int    @map("system_qty")
  countedQty Int?   @map("counted_qty")

  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  batch Batch      @relation(fields: [batchId], references: [id])

  @@map("stock_count_line")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entity      String
  entityId    String   @map("entity_id")
  at          DateTime @default(now())
  ip          String?

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entity, entityId])
  @@index([at])
  @@map("audit_log")
}

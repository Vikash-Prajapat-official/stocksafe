{
  "name": "stocksafe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Free, open-source stock, expiry and reorder tracker for Indian hospital stores and pharmacies.",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "node --env-file-if-exists=.env scripts/db.mjs generate && next build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "worker": "tsx src/worker/index.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node --env-file-if-exists=.env scripts/db.mjs generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node --env-file-if-exists=.env scripts/db.mjs migrate",
    "db:seed": "prisma db seed",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:all": "vitest run && vitest run -c vitest.integration.config.ts && npm run test:sqlite",
    "job:alerts": "tsx src/worker/index.ts once alerts",
    "job:retention": "tsx src/worker/index.ts once retention",
    "db:backup": "node --env-file-if-exists=.env scripts/sqlite-backup.mjs backup",
    "db:restore": "node --env-file-if-exists=.env scripts/sqlite-backup.mjs restore",
    "test:sqlite": "node scripts/generate-test-client.mjs && vitest run -c vitest.integration.sqlite.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.1",
    "@swc/helpers": "^0.5.24",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.16.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.11",
    "papaparse": "^5.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.29",
    "fast-check": "^4.3.0",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "smtp-server": "^3.21.7",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
